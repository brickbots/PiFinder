#: PiFinder/ui/sqm.py:406
msgid "Semi-Suburban/Transition Sky"
msgstr "Ciel Semi-Suburbain/Transition"

#: PiFinder/ui/sqm.py:410
msgid "Clouds have a grayish glow at zenith and appear bright toward city domes."
msgstr ""
"Les nuages ont une lueur grisâtre au zénith et apparaissent lumineux vers"
